# Copy this file to ".env" and fill in your real token.
# The real .env is git-ignored and must NEVER be committed.
TASKY_TOKEN=123456:ABC-your-token-from-botfather

# Optional: seconds between scrapes (default 300).
TASKY_POLL_INTERVAL=300

# Admin chat id. Required for invite management and /health.
TASKY_ADMIN_ID=

# Delete task records older than this many days (default 90).
TASKY_RETENTION_DAYS=90

# Optional fragile sources. Defaults are the reliable sources only:
# devpost, remotive, themuse.
# Example: TASKY_ENABLE_SCRAPERS=reddit,telegram
TASKY_ENABLE_SCRAPERS=
TASKY_DISABLE_SCRAPERS=

# Optional: override where the SQLite database lives. Defaults to ./tasky.db
# next to the project. On cloud hosts (e.g. Railway) point this at a mounted
# persistent volume so data survives redeploys, e.g. /data/tasky.db.
TASKY_DB=

# Optional: public Telegram channels to watch (comma-separated handles, the '@'
# is optional). Leave unset to use the built-in curated airdrop/quest channels.
# Only channels with their public web preview enabled work; others are skipped.
TASKY_TG_CHANNELS=

# Optional: Zealy communities to watch (comma-separated subdomains, e.g.
# "mycommunity,another"). Leave unset to skip Zealy entirely. Zealy's API needs
# a per-community key, so also set ZEALY_API_KEY below or the source stays
# dormant (skips cleanly) until you do.
TASKY_ZEALY_COMMUNITIES=

# Optional: Zealy API key (x-api-key) for the communities above. Generated in a
# Zealy community's admin settings. Without it the Zealy source is a clean no-op.
ZEALY_API_KEY=
